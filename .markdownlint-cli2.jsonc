// Markdown linting (ADR-0013). Prettier formats Markdown; this catches what a
// formatter cannot see — a skipped heading level, a code fence with no language,
// an empty or reversed link. Every rule disabled below is disabled for a reason.
{
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "dist", ".astro", ".claude", ".cursor", ".idea"],

  "config": {
    // --- Cosmetics. Prettier owns these where it runs; where it does not
    // (docs/, spec/, CONTEXT.md, README.md) the wrapping and tables are
    // hand-aligned on purpose, and reformatting them was declined in ADR-0012.
    "MD013": false, // line-length: prose is hand-wrapped at ~95, not 80
    "MD022": false, // blanks-around-headings
    "MD029": false, // ol-prefix
    "MD031": false, // blanks-around-fences
    "MD032": false, // blanks-around-lists
    "MD058": false, // blanks-around-tables
    "MD060": false, // table-column-style: the hand-aligned pipes stay

    // --- Bare URLs. GFM autolinks them, so they render correctly; all 56 hits
    // are citations in spec/seo-aeo-research.md, where a naked source URL is
    // the point.
    "MD034": false,

    // --- Contradicted by ADR-0003 on purpose.
    // Raw HTML in posts is a feature: an <iframe> or <video> inline is exactly
    // why MDX was not installed.
    "MD033": false,
    // Content files have no H1 in the body — the title comes from frontmatter
    // and the page renders it. fun-links.md deliberately starts at ### because
    // it renders inside the homepage's "Fun Links" <h2>.
    "MD041": false,
  },
}
