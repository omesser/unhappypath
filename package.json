{
  "name": "unhappypath",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "prettier --check . && markdownlint-cli2 && astro check && npm run build:site && node scripts/check-urls.mjs && node scripts/contrast.mjs",
