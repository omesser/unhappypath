---
import { getCollection, render } from 'astro:content';
import ExternalLink from '../components/ExternalLink.astro';
import PostList from '../components/PostList.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { Content as Links } from '../content/links.md';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest, personLd } from '../utils';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(
	projects.map(async (p) => ({ ...p, Body: (await render(p)).Content })),
);

const recent = (await getCollection('notes')).sort(byNewest).slice(0, 5);

// Person + WebSite (spec §8). The Person node carries the authorship a human
// visitor never sees in large type — sameAs is what makes it an entity.
const home = new URL('/', Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${home}#website`,
			url: home,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			publisher: { '@id': `${home}#person` },
		},
		personLd(Astro.site!),
	],
};
---

<BaseLayout jsonLd={jsonLd}>
	<section id="about" class="hero" aria-label="About">
		<img src="/avatar.jpg" width="104" height="104" alt="Oded Messer - comic-style portrait" />
		<div class="hero-body">
			<h1>{SITE_TITLE} <span class="muted">| {SITE_TAGLINE}</span></h1>
			<p>
				Welcome to my little neck of the woods. This is where I write about software systems,
				architecture, processes, leadership, the paths that do not go as planned, why, and how to
				make them (hopefully) better. Lately this includes figuring out where AI actually helps
				engineering work, and where it does not.
			</p>
			<p>
				I write about things I care about - they are usually unglamorous, and rarely innovative, but
				hopefully concise, insightful and entertaining enough to read through. I hope there's
				something here for you to take away and apply in your scenario or line of work. That's it.
				Welcome to <em>Unhappy Path</em>.
			</p>
			<p class="socials">
				<ExternalLink href={AUTHOR.github}>GitHub</ExternalLink>
				<ExternalLink href={AUTHOR.linkedin}>LinkedIn</ExternalLink>
			</p>
		</div>
	</section>

	<section id="notes">
		<div class="section-head">
			<h2>Notes</h2>
			<p class="muted"><small>Notes on engineering, systems, and leadership.</small></p>
		</div>
		<PostList posts={recent} />
		<p>
			<a href="/notes">Browse all notes →</a>
			<span class="muted"> · </span>
			<a href="/rss.xml">RSS</a>
		</p>
	</section>

	<section id="projects">
		<div class="section-head">
			<h2>Projects</h2>
			<p class="muted"><small>A few things I've built or contributed to.</small></p>
		</div>
		<div class="projects">
			{
				cards.map(({ data, Body }) => (
					<article class="card">
						<h3>
							<ExternalLink href={data.github}>{data.title}</ExternalLink>
						</h3>
						<Body />
						{data.tags.length > 0 && (
							<ul class="tags">
								{data.tags.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						)}
						{data.live && (
							<p class="card-links">
								<ExternalLink href={data.live}>Live</ExternalLink>
							</p>
						)}
					</article>
				))
			}
		</div>
	</section>

	<section id="links" class="links">
		<h2>Links</h2>
		<Links />
	</section>
</BaseLayout>
