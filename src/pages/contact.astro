---
import ExternalLink from '../components/ExternalLink.astro';
import { AUTHOR, CONTACT_EMAIL } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact"
	description="How to reach Oded Messer — what to reach out about, and where."
>
	<h1>Contact</h1>

	<p>Happy to hear from you. Here is the best way to reach me.</p>

	<h2>Get in touch if…</h2>
	<ul>
		<li>Something I wrote was wrong, or you have a better counter-example.</li>
		<li>You want to chat about distributed systems, software architecture, MLOps, AIOps or to philosophize about software futurism.</li>
		<li>You have an unusual engineering leadership problem, need advice or want to compare notes.</li>
	</ul>

	<h2>Where</h2>
	<ul>
		<li>
			<strong>LinkedIn DM</strong> — <ExternalLink href={AUTHOR.linkedin}>
				linkedin.com/in/odedmesser
			</ExternalLink>. Best for anything short.
		</li>
		<li>
			<strong>Email</strong> — <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Best for
			anything long, or anything with an attachment.
		</li>
		<li>
			<strong>GitHub</strong> — <ExternalLink href={AUTHOR.github}>
				github.com/omesser
			</ExternalLink>. Issues and PRs on anything of mine.
		</li>
	</ul>
</BaseLayout>
