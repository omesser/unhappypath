---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isoDate, monthYear } from '../utils';

const posts = (await getCollection('writing')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Writing"
	description="Every post — timeless notes on engineering, systems, leadership, and the unhappy paths."
>
	<h1>Writing</h1>
	<p class="muted">
		Everything, newest first. <a href="/rss.xml">RSS</a>.
	</p>
	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<time datetime={isoDate(post.data.pubDate)}>{monthYear(post.data.pubDate)}</time>
					<h3><a href={`/writing/${post.id}`}>{post.data.title}</a></h3>
					<p>{post.data.description}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>
