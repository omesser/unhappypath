---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest } from '../utils';

const posts = (await getCollection('writing')).sort(byNewest);
---

<BaseLayout
	title="Writing"
	description="Every post — timeless notes on engineering, systems, leadership, and the unhappy paths."
>
	<h1>Writing</h1>
	<p class="muted">
		Everything, newest first. <a href="/rss.xml">RSS</a>.
	</p>
	<PostList posts={posts} level={2} />
</BaseLayout>
